  const queues = db.query("SELECT id, state, concurrency FROM queues ORDER BY id").all();
  let started = 0;
  let stayedStopped = 0;
  for (const queue of queues) {
    if (queue.state === "STOPPED") {
      stayedStopped++;
      continue;
    }
    if (queue.state !== "PROCESSING") {
      updateQueueState(db, queue.id, "PROCESSING");
    }
    started++;
  }
  return { started, stayedStopped };
}
function ensureQueuesForTasks(db) {
  const tasks = db.query("SELECT id, concurrency FROM tasks").all();
  for (const task of tasks) {
    ensureQueue(db, task.id, task.concurrency);
  }
}
