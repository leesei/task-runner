  for (const task of projectTasks) {
    const existing = seen.get(task.id);
    if (existing) {
      warnings.push(`Task ${task.id} from project shadows ${existing} (skipped)`);
      continue;
    }
    seen.set(task.id, "project");
    tasks.push(task);
  }
  const userTasks = discoverUserTasks();
  for (const task of userTasks) {
    const existing = seen.get(task.id);
    if (existing && existing !== "project") {
      warnings.push(`Task ${task.id} from user folder shadows ${existing} (skipped)`);
      continue;
