async function executeTask(db, instanceId, task, input, signal, logDir) {
  const logPath = createLogFile(logDir, instanceId);
  db.run("UPDATE instances SET log_path = ? WHERE id = ?", [logPath, instanceId]);
  updateInstanceState(db, instanceId, "RUNNING");
  let completed = false;
  const ctx = {
    input,
    signal,
    done: (exitCode) => {
      if (completed) {
        console.warn(`Instance ${instanceId}: second done() call ignored (exitCode was ${exitCode})`);
        return;
      }
      completed = true;
      if (exitCode === 0) {
        updateInstanceState(db, instanceId, "SUCCESS");
      } else {
        updateInstanceState(db, instanceId, "FAILED", exitCode);
      }
    }
  };
  const result = await runInInstanceContext({ instanceId, db }, async () => {
    const importPath = task.entryPoint;
    const module = await import(importPath);
    const taskFn = module.default;
    if (!taskFn || typeof taskFn !== "function") {
      console.error(`Task ${task.id}: no default export found`);
      if (!completed) {
        updateInstanceState(db, instanceId, "FAILED", 1, "no_default_export");
      }
      return;
    }
    try {
      await taskFn(ctx);
      if (!completed) {
        updateInstanceState(db, instanceId, "SUCCESS");
      }
    } catch (err) {
      if (!completed) {
        const message = err?.message ?? String(err);
        console.error(`Task ${task.id}: ${message}`);
        updateInstanceState(db, instanceId, "FAILED", 1, message);
      }
    }
  });
  return result;
}

// src/runner/runner.ts
init_database();
var DEFAULT_CONFIG = {
  pollIntervalMs: 1000,
  dataDir: ".tq"
};
function createRunner(config = {}) {
  const cfg = { ...DEFAULT_CONFIG, ...config };
  const dbConfig = resolveDataDir(cfg.dataDir);
  return {
    async runOnce(db) {
      let launched = 0;
      const queues = db.query("SELECT id, concurrency FROM queues WHERE state = 'PROCESSING' ORDER BY id").all();
      for (const queue of queues) {
        const running = getRunningInstances(db, queue.id);
        if (running.length >= queue.concurrency)
          continue;
        const pending = getPendingInstances(db, queue.id);
        if (pending.length === 0)
          continue;
        const slotsAvailable = queue.concurrency - running.length;
        const toLaunch = Math.min(slotsAvailable, pending.length);
        for (let i = 0;i < toLaunch; i++) {
          const instance = pending[i];
          const task = getTask(db, queue.id);
          if (!task)
            continue;
          let input = {};
          try {
            input = JSON.parse(instance.input);
          } catch {
            input = instance.input;
          }
          executeTask(db, instance.id, {
            id: task.id,
            entryPoint: `file://${task.id}`,
            timeoutMs: task.timeout_ms
          }, input, new AbortController().signal, dbConfig.logDir).catch((err) => {
            console.error(`Task execution error for instance ${instance.id}:`, err);
          });
          launched++;
        }
      }
      for (const queue of queues) {
        checkDrained(db, queue.id);
      }
      return launched;
    },
    async runContinuous(db) {
      while (true) {
        await this.runOnce(db);
        await Bun.sleep(cfg.pollIntervalMs);
      }
    }
  };
}

// src/cli/commands/daemon.ts
async function commandDaemon(dataDir, port, flags) {
  const fs = __require("fs");
  const dbConfig = resolveDataDir(dataDir);
  try {
    bootstrapDataDir(dbConfig);
  } catch (err) {
    console.error(`Error creating data directory ${dataDir}: ${err.message}`);
    return 1;
  }
  let db;
  try {
    db = openDatabase(dbConfig.dbPath);
    configureDatabase(db);
  } catch (err) {
    console.error(`Error opening database: ${err.message}`);
    return 1;
  }
  let actualPort = port;
  let server;
  try {
    server = Bun.serve({
      port,
      fetch(req) {
        return new Response("tq daemon running", { status: 200 });
      }
    });
    actualPort = server.port;
  } catch (err) {
    console.error(`Error: cannot bind to port ${port}: ${err.message}`);
    return 1;
  }
  const descriptor = {
    pid: process.pid,
    port: actualPort,
    dataDir,
    startedAt: new Date().toISOString()
  };
  fs.writeFileSync(`${dataDir}/daemon.json`, JSON.stringify(descriptor, null, 2));
  console.log(`tq daemon running on http://localhost:${actualPort}`);
  console.log(`Data directory: ${dataDir}`);
  console.log("Press Ctrl+C to stop");
  const cwd = process.cwd();
  const packageLocations = getPackageLocations(dataDir);
  const { loaded, warnings } = loadAllTasks(db, cwd, packageLocations);
  console.log(`Loaded ${loaded} task(s)`);
  for (const warning of warnings) {
    console.warn(`Warning: ${warning}`);
  }
  ensureQueuesForTasks(db);
  const { started, stayedStopped } = autostartQueuesOnBoot(db);
  console.log(`Autostart: ${started} queue(s) processing, ${stayedStopped} stayed stopped`);
  installConsoleInterception();
  const runner = createRunner({ dataDir });
  console.log("Runner loop started");
  runner.runContinuous(db).catch((err) => {
    console.error("Runner loop error:", err);
  });
  const descriptorPath = `${dataDir}/daemon.json`;
  const controller = new AbortController;
  const shutdown = () => {
    console.error(`
Shutting down...`);
    try {
      fs.unlinkSync(descriptorPath);
    } catch {}
    if (db)
      closeDatabase(db);
    server.stop();
    controller.abort();
  };
  process.on("SIGINT", shutdown);
