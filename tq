    return [];
  const entries = readdirSync(tasksDir, { withFileTypes: true });
  const tasks = [];
  for (const entry of entries) {
    if (!entry.isDirectory())
      continue;
    const taskDir = join(tasksDir, entry.name);
    const discovered = resolveTaskDir(taskDir);
    if (discovered) {
      tasks.push(discovered);
    }
  }
